# Direct-host API development: use localhost, not the Compose db service name.
DATABASE_URL=postgresql+psycopg://freecoinalert:change-me-local-only@localhost:5432/freecoinalert

# Browser authentication for local direct-host development.
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Telegram linking and local update-processor configuration
# The bot token is secret; use a local-only value and never commit it.
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_SECONDS=600
TELEGRAM_BOT_TOKEN=
TELEGRAM_UPDATE_RETENTION_DAYS=30

# Never commit secrets or local environment files.
