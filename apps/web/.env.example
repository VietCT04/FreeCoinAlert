# Browser-exposed variables must use the NEXT_PUBLIC_ prefix.
# Never use NEXT_PUBLIC_ for secrets or credentials.
# Add variables only when implemented code consumes them.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-owned metadata configuration; these values are not browser variables.
SITE_URL=http://localhost:3000
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
