# Committed, non-secret values for the isolated E2E Compose project.
COMPOSE_PROFILES=market,telegram,historical-analysis,e2e

POSTGRES_DB=freecoinalert_e2e
POSTGRES_USER=freecoinalert_e2e
POSTGRES_PASSWORD=freecoinalert_e2e_only

WEB_PORT=3100
API_PORT=8100
POSTGRES_PORT=55432
E2E_WEB_ORIGIN=http://web.freecoinalert.test:3000
E2E_API_ORIGIN=http://api.freecoinalert.test:8000
WEB_ORIGIN=http://web.freecoinalert.test:3000
NEXT_PUBLIC_API_BASE_URL=http://api.freecoinalert.test:8000
SESSION_COOKIE_SECURE=false

E2E_TEST_MODE=true
E2E_CLOCK_NOW=2026-08-04T00:00:00Z
E2E_CONTROL_TOKEN=e2e-control-only
E2E_WORKER_GATE_ENABLED=true

TELEGRAM_BOT_USERNAME=e2e_bot
TELEGRAM_BOT_TOKEN=e2e-bot-token
TELEGRAM_BOT_API_BASE_URL=http://provider-simulator:9000/bot
TELEGRAM_BOT_FILE_BASE_URL=http://provider-simulator:9000/file/bot
TELEGRAM_PUBLIC_BOT_BASE_URL=http://provider-simulator:9000/telegram

BINANCE_SPOT_BASE_URL=http://provider-simulator:9000
BINANCE_SPOT_WS_BASE_URL=ws://provider-simulator:9000
MARKET_CATALOG_MAX_AGE_SECONDS=86400
MARKET_EVENT_MAX_AGE_SECONDS=30
MARKET_EVENT_FUTURE_TOLERANCE_SECONDS=5
MARKET_CATALOG_REFRESH_SECONDS=30
MARKET_STREAM_RECONNECT_MAX_SECONDS=2
CANDLE_WS_MAX_AGE_SECONDS=30
CANDLE_DATA_MAX_LAG_SECONDS=30
CANDLE_RECENT_RECONCILIATION_SECONDS=30
CANDLE_RECENT_RECONCILIATION_HOURS=1

HISTORICAL_ANALYSIS_WORKER_POLL_SECONDS=0.25
HISTORICAL_ANALYSIS_WORKER_CLAIM_LIMIT=1
HISTORICAL_ANALYSIS_WORKER_STALE_SECONDS=60
