# Local Docker Compose ports
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432

# Local setup and preflight
LOCAL_ENABLE_TELEGRAM=false
LOCAL_STARTUP_TIMEOUT_SECONDS=1800

# Local PostgreSQL initialization values
POSTGRES_DB=freecoinalert
POSTGRES_USER=freecoinalert
POSTGRES_PASSWORD=change-me-local-only

# API database connection (used for direct-host API development)
DATABASE_URL=postgresql+psycopg://freecoinalert:change-me-local-only@localhost:5432/freecoinalert

# Browser authentication for local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Telegram linking, update processor, and notification-worker configuration
# The bot token is secret; use a local-only value and never commit it.
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_SECONDS=600
TELEGRAM_BOT_TOKEN=
TELEGRAM_UPDATE_RETENTION_DAYS=30
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org/bot
TELEGRAM_BOT_FILE_BASE_URL=https://api.telegram.org/file/bot
TELEGRAM_PUBLIC_BOT_BASE_URL=https://t.me

# Public Binance Spot catalog synchronization; no API key is used.
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_PUBLIC_DATA_BASE_URL=https://data.binance.vision
MARKET_CATALOG_MAX_AGE_SECONDS=86400
BINANCE_SPOT_WS_BASE_URL=wss://stream.binance.com:9443
MARKET_EVENT_MAX_AGE_SECONDS=10
MARKET_EVENT_FUTURE_TOLERANCE_SECONDS=2
MARKET_CATALOG_REFRESH_SECONDS=21600
MARKET_STATE_WRITE_INTERVAL_SECONDS=1
MARKET_STREAM_RECONNECT_MAX_SECONDS=30
CANDLE_RETENTION_DAYS=765
CANDLE_WS_MAX_AGE_SECONDS=180
CANDLE_DATA_MAX_LAG_SECONDS=180
CANDLE_RECONCILIATION_LOOKBACK_HOURS=24
CANDLE_RECENT_RECONCILIATION_SECONDS=900
CANDLE_RECENT_RECONCILIATION_HOURS=6
CANDLE_BACKFILL_TARGET_DAYS=765
CANDLE_BACKFILL_MAINTENANCE_SECONDS=900
CANDLE_BACKFILL_CHUNK_PAUSE_SECONDS=0.1
SIGNAL_LIVE_CATCHUP_MAX_DAYS=7
SIGNAL_HISTORY_DAYS=90
SIGNAL_EVENT_RETENTION_DAYS=365
SIGNAL_SSE_MAX_CONNECTIONS_PER_USER=2
SIGNAL_SSE_MAX_CONNECTIONS_PER_PROCESS=500
SIGNAL_SSE_QUEUE_SIZE=100
SIGNAL_SSE_HEARTBEAT_SECONDS=15
SIGNAL_SSE_SESSION_REVALIDATION_SECONDS=60
SIGNAL_STREAM_RETENTION_DAYS=7
SIGNAL_TELEGRAM_FANOUT_BATCH_SIZE=100
SIGNAL_TELEGRAM_FANOUT_CLAIM_LIMIT=10
SIGNAL_TELEGRAM_FANOUT_POLL_SECONDS=2
SIGNAL_TELEGRAM_FANOUT_MAX_AGE_SECONDS=900

# Historical-analysis worker and bounded terminal-run retention
HISTORICAL_ANALYSIS_WORKER_POLL_SECONDS=2
HISTORICAL_ANALYSIS_WORKER_CLAIM_LIMIT=1
HISTORICAL_ANALYSIS_WORKER_STALE_SECONDS=600
HISTORICAL_ANALYSIS_RETENTION_DAYS=30
HISTORICAL_ANALYSIS_CLEANUP_BATCH_SIZE=100
