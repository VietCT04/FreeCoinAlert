{
  "name": "free-coin-alert",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev:setup": "node scripts/local-dev.mjs setup",
    "dev:preflight": "node scripts/local-dev.mjs preflight",
    "dev": "docker compose up --build",
    "dev:detached": "docker compose up --build --detach --wait",
    "dev:status": "docker compose ps",
    "dev:logs": "docker compose logs --follow",
    "dev:telegram": "docker compose --profile telegram up --build",
    "dev:telegram-logs": "docker compose --profile telegram logs --follow telegram-updates",
    "dev:telegram-updates": "uv run --project apps/api python -m freecoinalert_api.telegram.poller",
    "dev:market": "docker compose --profile market up --build",
    "dev:market-stream": "uv run --project apps/api python -m freecoinalert_api.market_data.stream",
    "dev:market-logs": "docker compose --profile market logs --follow market-stream",
    "dev:notification-worker": "uv run --project apps/api python -m freecoinalert_api.notifications.worker",
    "dev:signal-telegram-dispatcher": "uv run --project apps/api python -m freecoinalert_api.notifications.signal_dispatcher",
    "analysis:worker": "uv run --project apps/api python -m freecoinalert_api.historical_analysis.worker",
    "analysis:cleanup": "uv run --project apps/api python -m freecoinalert_api.historical_analysis.cleanup",
    "market:sync": "uv run --project apps/api python -m freecoinalert_api.market_data.catalog_sync",
    "market:candles-bootstrap": "uv run --project apps/api python -m freecoinalert_api.market_data.candles.bootstrap",
    "market:candles-reconcile": "uv run --project apps/api python -m freecoinalert_api.market_data.candles.reconciliation",
    "signals:backfill": "uv run --project apps/api python -m freecoinalert_api.signals.backfill",
    "dev:down": "docker compose down --remove-orphans",
    "dev:reset": "docker compose down --volumes --remove-orphans",
    "format": "prettier --write . --ignore-unknown && pnpm format:api",
    "format:check": "prettier --check . --ignore-unknown && pnpm format:check:api",
    "verify": "pnpm format:check && pnpm lint:web && pnpm typecheck:web && pnpm build:web && pnpm lint:api && pnpm typecheck:api",
    "dev:web": "pnpm --filter @freecoinalert/web dev",
    "build:web": "pnpm --filter @freecoinalert/web build",
    "lint:web": "pnpm --filter @freecoinalert/web lint",
    "typecheck:web": "pnpm --filter @freecoinalert/web typecheck",
    "dev:api": "uv run --project apps/api fastapi dev apps/api/src/freecoinalert_api/main.py --host 0.0.0.0 --port 8000",
    "db:migrate": "uv run --project apps/api alembic upgrade head",
    "db:revision": "uv run --project apps/api alembic revision --autogenerate -m",
    "lint:api": "uv run --project apps/api ruff check apps/api",
    "format:api": "uv run --project apps/api ruff format apps/api",
    "format:check:api": "uv run --project apps/api ruff format --check apps/api",
    "typecheck:api": "uv run --project apps/api mypy apps/api/src"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
